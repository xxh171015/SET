<view class="body">
  <view wx:if="{{primaryAction === 'goToSettings'}}">
    <view class="card">
      <view class="title">还没有 Manifest</view>
      <view class="muted">在设置里贴上 Manifest 的 HTTPS 地址。</view>
    </view>
    <button class="primary" bindtap="goToSettings">{{actionLabel}}</button>
  </view>
  <view wx:elif="{{!empty}}">
    <view
      wx:for="{{stages}}"
      wx:key="stageId"
      class="stage stage-{{item.stageId}}"
      data-stage-id="{{item.stageId}}"
      bindtap="openStage"
    >
      <view class="title">{{item.name}}</view>
      <view class="muted">{{item.showSummary}}</view>
    </view>
  </view>
</view>
