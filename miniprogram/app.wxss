page {
  background: #f5f5f5;
  color: #111111;
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-size: 16px;
}

.body {
  min-height: 100%;
  padding-bottom: 24rpx;
}

.card {
  background: #ffffff;
  margin: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.muted {
  color: #888888;
  font-size: 24rpx;
  margin-top: 12rpx;
  line-height: 1.5;
}

.primary {
  background: #07c160;
  color: #ffffff;
  border: 0;
  border-radius: 16rpx;
  margin: 24rpx;
  font-size: 30rpx;
}

.primary::after {
  border: 0;
}
